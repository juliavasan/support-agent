# Copy to .env and fill in values. Never commit .env.

# --- ServiceNow (Personal Developer Instance) ---
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_ASSIGNMENT_GROUP=
SERVICENOW_KNOWLEDGE_BASE=
SERVICENOW_SEED_USERNAME=
SERVICENOW_SEED_PASSWORD=

# --- LangSmith (optional: tracing + Studio) ---
# Tracing sends run inputs/outputs (incident data) to LangSmith. Synthetic data only.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=support-agent

# --- Jira Cloud ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=
# api (default): the Anthropic API with ANTHROPIC_API_KEY.
# claude_cli: Claude Code headless (`claude -p`) on your Claude subscription, for local
# development. Runs with all tools disabled, in an empty temp directory.
LLM_BACKEND=
CLAUDE_CLI_PATH=
# Model for LLM triage analysis (default: claude-opus-5-5, ~2.6 cents per incident).
# claude-haiku-5-5 is ~0.06 cents per incident and recommended for development.
# Effort: low | medium | high | xhigh | max (default: medium).
TRIAGE_MODEL=
TRIAGE_EFFORT=
LLM_TIMEOUT_SECONDS=120
REASONING_MODEL=

# --- Retrieval (RAG over the KB, known issues, and incidents) ---
# Hybrid index in Postgres + pgvector: start it with `docker compose up -d`.
# Leave RETRIEVAL_DATABASE_URL empty to use the keyword-only SQLite index instead.
RETRIEVAL_DB_PASSWORD=
RETRIEVAL_DATABASE_URL=postgresql://support_agent:<RETRIEVAL_DB_PASSWORD>@127.0.0.1:5433/support_agent
# Embeddings: Voyage AI (Anthropic's recommended provider). Key from dashboard.voyageai.com.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSIONS=1024
# Reranker model (default claude-haiku-5-5) and minimum rerank score 0-10 (default 7).
RERANK_MODEL=
# SQLite index path when RETRIEVAL_DATABASE_URL is empty (default data/retrieval.db).
RETRIEVAL_DB_PATH=
# Incremental sync from ServiceNow before each run (default true).
RETRIEVAL_SYNC_ON_RUN=

# --- Browser (CDP) ---
CDP_URL=
DEMO_APP_BASE_URL=
BROWSER_ALLOWED_ORIGINS=
CHROME_PROFILE_DIR=

# --- Policy / guardrails ---
# Mode for runs that don't set one (e.g. LangSmith Studio with `mode` left empty):
# dry_run (default) or write. The CLI is always dry run unless --write is given.
DEFAULT_RUN_MODE=dry_run
# Write mode is refused unless the incident is listed here (comma-separated).
WRITE_TEST_INCIDENTS=
# Optional override of src/support_agent/analysis/priority_matrix.json
PRIORITY_MATRIX_PATH=
# Optional override of src/support_agent/analysis/customer_tiers.json (premium customers)
CUSTOMER_TIERS_PATH=
AGENT_KILL_SWITCH=
JIRA_AUTO_CONFIDENCE=
KB_RELEVANCE_THRESHOLD=
MAX_AGENT_STEPS=

# --- Runtime ---
POLL_INTERVAL_SECONDS=
STATE_DB_PATH=
TRACES_DIR=
LOG_LEVEL=INFO
