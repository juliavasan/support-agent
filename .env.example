# Copy to .env and fill in values. Never commit .env.

# --- ServiceNow (Personal Developer Instance) ---
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_ASSIGNMENT_GROUP=
SERVICENOW_KNOWLEDGE_BASE=
SERVICENOW_SEED_USERNAME=
SERVICENOW_SEED_PASSWORD=

# --- LangSmith (optional: tracing + Studio) ---
# Tracing sends run inputs/outputs (incident data) to LangSmith. Synthetic data only.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=support-agent

# --- Jira Cloud ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=
TRIAGE_MODEL=
REASONING_MODEL=

# --- Browser (CDP) ---
CDP_URL=
DEMO_APP_BASE_URL=
BROWSER_ALLOWED_ORIGINS=
CHROME_PROFILE_DIR=

# --- Policy / guardrails ---
AGENT_KILL_SWITCH=
JIRA_AUTO_CONFIDENCE=
KB_RELEVANCE_THRESHOLD=
MAX_AGENT_STEPS=

# --- Runtime ---
POLL_INTERVAL_SECONDS=
STATE_DB_PATH=
TRACES_DIR=
LOG_LEVEL=INFO
